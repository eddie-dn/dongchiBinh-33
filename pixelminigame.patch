+  box-shadow:0 0 10px var(--neon);transition:width .3s ease}
+#startBtn{
+  font-family:var(--f-pixel);font-size:11px;padding:14px 18px;border:0;cursor:pointer;
+  color:#04140a;background:linear-gradient(180deg,#4dff96,#00c94f);
