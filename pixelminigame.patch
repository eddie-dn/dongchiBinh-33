+
+/* Chạm lá thư — bỏ qua nếu vừa vuốt camera (tránh mở nhầm khi pan) */
+el.hotspot.addEventListener('click', e=>{
+  e.stopPropagation();
+  if(CAM.moved) return;
+  openModal();
+});
+
+/* ═══ 9. MODAL · SLIDESHOW + THƯ ═════════════════════════════════════════ */
+let slideIdx = 0, slideTimer = 0, letterToken = 0;
+
+/* Chưa có file ảnh thì tự vẽ ảnh pixel thay thế bằng canvas */
+function pixelPlaceholder(i){
+  const W = 160, H = 120;
+  const cv = document.createElement('canvas');
+  cv.width = W; cv.height = H;
+  const g = cv.getContext('2d');
+  const sky = g.createLinearGradient(0,0,0,H);
+  sky.addColorStop(0,'#141d33'); sky.addColorStop(1,'#2a1a3c');
+  g.fillStyle = sky; g.fillRect(0,0,W,H);
+  /* sao pixel */
+  g.fillStyle = '#8fb7ff';
+  for(let k=0;k<26;k++){
+    const x = (k*37 + i*13) % W, y = (k*23 + i*7) % (H*0.6);
+    g.fillRect(x|0, y|0, 2, 2);
+  }
+  /* núi pixel */
+  g.fillStyle = '#1d2b45';
+  for(let x=0;x<W;x+=4){
+    const h = 26 + Math.round(14*Math.sin((x+i*20)/22) + 8*Math.sin(x/7));
+    g.fillRect(x, H-34-h, 4, h+34);
+  }
+  /* trái tim pixel */
+  const heart = [
+    '0110110','1111111','1111111','0111110','0011100','0001000'
+  ];
+  g.fillStyle = '#ff5b8a';
+  heart.forEach((row,r)=>[...row].forEach((c,q)=>{
+    if(c === '1') g.fillRect(W/2 - 21 + q*6, 34 + r*6, 6, 6);
+  }));
+  /* nhãn */
+  g.fillStyle = 'rgba(0,0,0,.55)'; g.fillRect(0, H-20, W, 20);
+  g.fillStyle = '#00ff66'; g.font = '9px monospace'; g.textAlign = 'center';
+  g.fillText((C.photo_captions[i] || ('MEMORY 0'+(i+1))) + ' · N/A', W/2, H-7);
+  return cv.toDataURL('image/png');
+}
+
+function buildSlides(){
+  el.show.innerHTML = ''; el.dots.innerHTML = '';
+  C.photos.forEach((p, i)=>{
+    const im = document.createElement('img');
+    im.alt = C.photo_captions[i] || ('Ảnh kỷ niệm ' + (i+1));
+    im.loading = 'eager';
+    im.onerror = function(){ this.onerror = null; this.src = pixelPlaceholder(i); };
+    im.src = C.photos_base + p;
+    if(i === 0) im.classList.add('on');
+    el.show.appendChild(im);
+    const d = document.createElement('i');
+    if(i === 0) d.classList.add('on');
+    el.dots.appendChild(d);
+  });
+}
+function goSlide(n){
+  const imgs = el.show.children, dots = el.dots.children;
+  if(!imgs.length) return;
+  slideIdx = (n + imgs.length) % imgs.length;
+  [...imgs].forEach((im,i)=> im.classList.toggle('on', i === slideIdx));
+  [...dots].forEach((d,i)=> d.classList.toggle('on', i === slideIdx));
+}
+function autoSlide(){
+  clearInterval(slideTimer);
+  slideTimer = setInterval(()=> goSlide(slideIdx + 1), T.slide_auto);
+}
+el.prev.addEventListener('click', ()=>{ goSlide(slideIdx - 1); autoSlide(); });
+el.next.addEventListener('click', ()=>{ goSlide(slideIdx + 1); autoSlide(); });
+
+function typeLetter(){
+  const my = ++letterToken;
+  const txt = C.letter_content;
+  el.letterBox.textContent = '';
+  el.finish.disabled = true;
+  let i = 0;
+  (function step(){
+    if(my !== letterToken) return;
+    el.letterBox.textContent = txt.slice(0, i += 1);
+    el.letterBox.scrollTop = el.letterBox.scrollHeight;
+    if(i < txt.length) setTimeout(step, T.letter_speed);
+    else el.finish.disabled = false;
+  })();
+}
+/* Chạm vào khung thư → hiện hết chữ ngay */
+el.letterBox.addEventListener('click', ()=>{
+  if(el.finish.disabled){
+    letterToken++;
+    el.letterBox.textContent = C.letter_content;
+    el.finish.disabled = false;
+  }
+});
+
+function openModal(){
+  el.hotspot.classList.remove('on');
+  el.modal.classList.add('on');
+  buildSlides(); goSlide(0); autoSlide(); typeLetter();
+}
+function closeModal(){
+  el.modal.classList.remove('on');
+  clearInterval(slideTimer);
+}
+el.finish.addEventListener('click', async ()=>{
+  if(el.finish.disabled) return;
+  closeModal();
+  S.done = true;
+  confetti();
+  await sayAll(C.dialogues.finale, 'cy');
+});
+
+/* ═══ 10. PHÁO HOA PIXEL ═════════════════════════════════════════════════ */
+function sizeFx(){
+  const r = Math.min(window.devicePixelRatio || 1, 2);
+  el.fx.width  = el.app.clientWidth  * r;
+  el.fx.height = el.app.clientHeight * r;
+  fxCtx.setTransform(r,0,0,r,0,0);
+}
+sizeFx();
+
+function confetti(){
+  const COLORS = ['#00ff66','#ffaa00','#00f2ff','#ff5b8a','#ffffff','#b79bf2'];
+  const W = el.app.clientWidth, H = el.app.clientHeight;
+  const parts = [];
+  const push = (x,y,n,spread,speed)=>{
+    for(let k=0;k<n;k++){
+      const a = Math.random()*Math.PI*2;
+      const v = speed*(0.35 + Math.random()*0.85);
+      parts.push({
+        x, y, vx:Math.cos(a)*v*spread, vy:Math.sin(a)*v - 1.4,
+        s: 3 + Math.round(Math.random()*3),
+        c: COLORS[(Math.random()*COLORS.length)|0],
+        life: 1, decay: 0.006 + Math.random()*0.008
+      });
+    }
+  };
+  /* mưa giấy từ trên xuống */
+  for(let k=0;k<90;k++){
+    parts.push({
+      x: Math.random()*W, y: -Math.random()*H*0.6,
+      vx: (Math.random()-0.5)*1.1, vy: 1.4 + Math.random()*2.4,
+      s: 3 + Math.round(Math.random()*3),
+      c: COLORS[(Math.random()*COLORS.length)|0],
+      life: 1, decay: 0.0035
+    });
+  }
+  el.fx.classList.add('on');
+  let bursts = 0;
+  const burstTimer = setInterval(()=>{
+    push(W*(0.18 + Math.random()*0.64), H*(0.18 + Math.random()*0.38), 46, 1, 4.2);
+    if(++bursts >= 6) clearInterval(burstTimer);
+  }, 620);
+  push(W*0.5, H*0.34, 60, 1, 4.6);
+
+  let alive = true;
+  const t0 = performance.now();
+  (function frame(now){
+    if(!alive) return;
+    fxCtx.clearRect(0,0,W,H);
+    let live = 0;
+    for(const p of parts){
+      p.vy += 0.055;                 /* trọng lực */
+      p.x += p.vx; p.y += p.vy;
+      p.vx *= 0.995;
+      p.life -= p.decay;
+      if(p.life <= 0 || p.y > H + 20) continue;
+      live++;
+      fxCtx.globalAlpha = Math.max(0, Math.min(1, p.life));
+      fxCtx.fillStyle = p.c;
+      fxCtx.fillRect(p.x|0, p.y|0, p.s, p.s);   /* ô vuông = pixel */
+    }
+    fxCtx.globalAlpha = 1;
+    if(live > 0 && now - t0 < 12000) requestAnimationFrame(frame);
+    else { alive = false; clearInterval(burstTimer); fxCtx.clearRect(0,0,W,H); el.fx.classList.remove('on'); }
+  })(performance.now());
+}
+
+/* ═══ 11. KHỞI ĐỘNG ══════════════════════════════════════════════════════ */
+placeSlabs();
+
+(async function bootUp(){
+  /* Chỉ CHỜ ảnh nền Round 1; clip nặng nạp ngầm phía sau. */
+  const need = [A('bg_r1')];
+  let done = 0;
+  const bump = ()=>{
+    done++;
+    const pct = Math.round(done / need.length * 100);
+    el.bar.style.width = pct + '%';
+    el.loadTxt.textContent = 'LOADING ' + pct + '%';
+  };
+  /* thanh tiến trình giả lập nhích dần cho đỡ đứng hình khi ảnh nặng */
+  let fake = 0;
+  const fakeTimer = setInterval(()=>{
+    fake = Math.min(fake + 3, 92);
+    if(done < need.length){
+      el.bar.style.width = fake + '%';
+      el.loadTxt.textContent = 'LOADING ' + fake + '%';
+    }
+  }, 180);
+
+  await Promise.all(need.map(s=> load(s).then(bump)));
+  clearInterval(fakeTimer);
+  el.bar.style.width = '100%';
+  el.loadTxt.textContent = 'LOADING 100%';
+  el.bootSub.textContent = C.ui.boot_ready;
+  el.startBtn.hidden = false;
+
+  /* nạp ngầm phần còn lại */
+  const idle = window.requestIdleCallback || (f=>setTimeout(f,600));
+  idle(()=>{ load(A('anim_wrong')); load(A('bg_r2')); });
+})();
+
+el.startBtn.addEventListener('click', ()=>{
+  el.boot.classList.add('gone');
+  setTimeout(()=>{ el.boot.style.display = 'none'; }, 520);
+  startRound1();
+});
+
+/* Ghi cờ đã qua Gate 2 — cùng khoá localStorage với các trang khác của bản đồ */
+try{
+  const m = JSON.parse(localStorage.getItem('mtv1') || '{}') || {};
+  if(!m.eggWin){ m.eggWin = true; localStorage.setItem('mtv1', JSON.stringify(m)); }
+}catch(_){}
+
+})();
+</script>
