+#unlock{
+  flex:0 0 auto;font-family:var(--f-pixel);font-size:10px;letter-spacing:.04em;
+  padding:0 15px;border:0;cursor:pointer;
+  color:#04140a;background:linear-gradient(180deg,#4dff96,#00c94f);
+  box-shadow:0 4px 0 #026b2b,0 0 18px rgba(0,255,102,.28);
