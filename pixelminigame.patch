+
+/* ═══ MODAL MẬT THƯ ════════════════════════════════════════════════════════ */
+#modal{
+  position:absolute;inset:0;z-index:50;display:none;
+  align-items:center;justify-content:center;padding:14px;
+  background:rgba(3,7,12,.86);backdrop-filter:blur(3px);
+}
+#modal.on{display:flex;animation:fadeIn .35s ease}
+@keyframes fadeIn{from{opacity:0}to{opacity:1}}
+.scroll{
+  width:100%;max-width:420px;max-height:calc(var(--vh,100dvh) - 28px);
