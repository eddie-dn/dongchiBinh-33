+  border:3px solid var(--bezel);padding:13px 10px;outline:none;
+  caret-color:var(--amber);
+}
+#answer::placeholder{color:rgba(215,226,238,.26);letter-spacing:.02em;font-family:var(--f-term)}
+#answer:focus{border-color:var(--neon);box-shadow:0 0 14px rgba(0,255,102,.28)}
+#answer:disabled{opacity:.45}
