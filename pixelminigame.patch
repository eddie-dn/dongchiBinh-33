+<style>
+/* ═══════════════════════════════════════════════════════════════════════════
+   DAD-950901-B · EASTER EGG GATE 2 — MINI-GAME PIXEL ART 2 ROUND
+   Một file duy nhất: HTML5 + CSS3 + Vanilla JS. Không thư viện ngoài.
+   Toàn bộ CÂU CHỮ và CẤU HÌNH nằm trong GAME_CONFIG ở đầu khối script.
+   ═══════════════════════════════════════════════════════════════════════════ */
+
+/* ── Bảng màu & token ───────────────────────────────────────────────────── */
+:root{
+  --bg:#0d1117;          /* nền xám đen Cyberpunk */
+  --bezel:#1f293d;       /* viền khung máy */
+  --neon:#00ff66;        /* xanh lá terminal */
+  --amber:#ffaa00;       /* cam neon — Round 1 */
+  --cyan:#00f2ff;        /* cyan neon — Round 2 */
+  --red:#ff3355;         /* log lỗi */
+  --paper:#d7e2ee;
+  --muted:rgba(215,226,238,.55);
+  --f-pixel:'Press Start 2P','Roboto Mono',ui-monospace,monospace;
+  /* Press Start 2P KHÔNG có dấu tiếng Việt → mọi câu tiếng Việt dùng --f-term */
+  --f-term:'Roboto Mono',ui-monospace,'Courier New',monospace;
+  --pan:0px;
+}
+
+*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
+html,body{margin:0;padding:0;height:100%}
+body{
+  background:var(--bg);color:var(--paper);
+  font-family:var(--f-term);
+  overflow:hidden;overscroll-behavior:none;
+  -webkit-font-smoothing:antialiased;
+  text-rendering:optimizeLegibility;
+}
+
+/* Khung app: cao đúng 100dvh, JS ghi đè --vh theo visualViewport để bàn phím
+   ảo không đẩy vỡ bố cục (iOS không co layout viewport khi mở bàn phím). */
+#app{
+  position:relative;
+  height:100dvh;height:var(--vh,100dvh);
+  max-width:520px;margin:0 auto;
+  display:flex;flex-direction:column;
+  background:radial-gradient(120% 80% at 50% 0%,#131c2a 0%,var(--bg) 70%);
+  overflow:hidden;
+}
+
+/* Khung pixel dùng lại: viền đặc + 4 góc bị "cắn" một ô vuông màu nền
+   → tạo cảm giác bo góc kiểu pixel mà không cần ảnh. */
+.pf{position:relative}
+.pf::before{
+  content:'';position:absolute;inset:-3px;pointer-events:none;z-index:3;
+  background-image:linear-gradient(var(--bg),var(--bg)),linear-gradient(var(--bg),var(--bg)),
+                   linear-gradient(var(--bg),var(--bg)),linear-gradient(var(--bg),var(--bg));
+  background-size:5px 5px;background-repeat:no-repeat;
+  background-position:0 0,100% 0,0 100%,100% 100%;
+}
+
+/* ═══ NỬA TRÊN · GAME VISUAL VIEWPORT ══════════════════════════════════════ */
+#stage{
+  flex:0 0 auto;
+  height:47dvh;height:calc(var(--vh,100dvh) * .47);
+  min-height:210px;
+  /* max(): máy không tai thỏ thì env() = 0, vẫn phải chừa mép trên tử tế */
+  padding:max(env(safe-area-inset-top,0px),14px) 12px 0;
+  display:flex;flex-direction:column;justify-content:flex-start;gap:8px;
+  transition:height .28s ease;
+}
+/* Ô chứa khung máy: nuốt hết phần cao dư, khung 16:9 luôn nằm giữa và tự co
+   lại khi bàn phím ảo bật (không bị bóp méo tỷ lệ). */
+.slot{flex:0 1 auto;min-height:0;width:100%;display:flex;align-items:center;justify-content:center}
+/* Bàn phím ảo bật → thu nhỏ nửa trên, nhường chỗ cho ô nhập. */
+body.kb-open #stage{height:min(30dvh,190px);padding-top:8px}
+body.kb-open #stage .hint{display:none}
+
+.hud{
+  display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;
+  font-family:var(--f-pixel);font-size:8px;letter-spacing:.06em;
+  color:var(--muted);flex:0 0 auto;
+}
+.hud .rnd{color:var(--amber)}
+.hud .st{display:inline-flex;align-items:center;gap:5px}
+.hud .dot{width:6px;height:6px;background:var(--red);box-shadow:0 0 8px currentColor;color:var(--red)}
+.hud.ok .dot{background:var(--neon);color:var(--neon)}
+.hud.ok .st{color:var(--neon)}
+
+/* Bezel retro + màn hình 16:9 */
+.bezel{
+  /* Bề ngang do fitBezel() chốt bằng px; chiều cao suy ra từ tỷ lệ 16:9.
+     (Không dùng max-height: trình duyệt KHÔNG truyền ràng buộc đó ngược qua
+     aspect-ratio khi width đã cố định → khung bị bóp méo lúc bàn phím bật.) */
+  width:100%;height:auto;aspect-ratio:16/9;max-width:100%;
+  border:3px solid var(--bezel);
+  background:#05080d;
+  box-shadow:0 0 0 1px #0a0f18,0 10px 30px rgba(0,0,0,.6),inset 0 0 40px rgba(0,0,0,.9);
+  position:relative;overflow:hidden;margin:auto;
+}
+.screen{position:absolute;inset:0;overflow:hidden;touch-action:none;cursor:grab}
+.screen.dragging{cursor:grabbing}
+.screen.locked{touch-action:auto;cursor:default}
+
+/* Lớp "thế giới": ảnh nền siêu rộng (3136×1376 ≈ 2.28:1) cao đúng bằng màn
+   hình 16:9 → dư ngang ~28% chính là biên độ cho camera lia/vuốt. */
+.world-wrap{position:absolute;inset:0;display:flex;justify-content:center;align-items:center}
+.world{
+  position:relative;height:100%;aspect-ratio:3136/1376;flex:0 0 auto;
+  transform:translate3d(var(--pan),0,0);
+  will-change:transform;
+}
+.bg-layer{position:absolute;inset:0;background-size:100% 100%;background-position:center;
+  transition:opacity .6s ease}
+
+/* Rồng: một bản sao ảnh nền được che (mask) quanh vùng đầu rồng rồi cho
+   "thở" bằng transform rất nhỏ → rồng như đang uốn lượn mà nền vẫn đứng yên. */
+.dragon-layer{
+  position:absolute;inset:0;background-size:100% 100%;opacity:0;
+  -webkit-mask-image:radial-gradient(ellipse 15% 34% at 49.5% 34%,#000 0%,#000 52%,transparent 100%);
+  mask-image:radial-gradient(ellipse 15% 34% at 49.5% 34%,#000 0%,#000 52%,transparent 100%);
+  animation:dragonFloat 5.2s ease-in-out infinite;
+  transition:opacity .8s ease;
+}
+@keyframes dragonFloat{
+  0%,100%{transform:translateY(0) scale(1)}
+  50%{transform:translateY(-0.55%) scale(1.007)}
+}
+.dragon-layer.on{opacity:1}
+.dragon-layer.empowered{animation-duration:2.4s;filter:drop-shadow(0 0 10px rgba(0,242,255,.6)) brightness(1.08)}
+
+/* Hào quang quanh rồng */
+.aura{
+  position:absolute;left:49.5%;top:34%;width:42%;height:76%;
+  transform:translate(-50%,-50%);
+  background:radial-gradient(ellipse at center,var(--aura-c,rgba(190,240,255,.55)) 0%,
+             var(--aura-c2,rgba(120,220,255,.22)) 38%,transparent 70%);
+  mix-blend-mode:screen;opacity:0;pointer-events:none;
+  animation:auraBreath 4.2s ease-in-out infinite;
+  transition:opacity .8s ease;
+}
+@keyframes auraBreath{
+  0%,100%{transform:translate(-50%,-50%) scale(.94);filter:brightness(.85)}
+  50%{transform:translate(-50%,-50%) scale(1.06);filter:brightness(1.2)}
+}
+.aura.on{opacity:.85}
+.aura.empowered{animation-duration:1.6s;opacity:1;width:52%;height:88%}
+.aura.angry{--aura-c:rgba(255,60,70,.6);--aura-c2:rgba(180,20,30,.3);animation-duration:.55s}
+
+/* ── Bệ đá khắc chữ (holo overlay đặt tuyệt đối theo % của "thế giới") ───── */
+.slab{
+  position:absolute;left:var(--sx);top:var(--sy);
+  transform:translate(-50%,-50%);
+  display:none;align-items:center;justify-content:center;
+  /* padding theo em, và fitSlabs() đặt font-size ngay trên .slab → cả tấm biển
+     co giãn cùng khung máy, không bao giờ thò ra ngoài mép dưới. */
+  padding:.34em .6em;white-space:nowrap;pointer-events:none;z-index:2;
+  background:linear-gradient(180deg,rgba(6,10,16,.86),rgba(6,10,16,.72));
+  border:1px solid rgba(255,255,255,.10);
+  box-shadow:0 2px 14px rgba(0,0,0,.65),inset 0 0 18px rgba(0,0,0,.6);
+}
+.slab.vis{display:flex}
+.slab .row{display:flex;gap:.16em;font-family:var(--f-pixel);line-height:1}
+.slab .ltr{
+  display:inline-block;opacity:.15;color:var(--slab-c);
+  transition:opacity .22s ease,text-shadow .22s ease,transform .55s cubic-bezier(.6,-.2,.3,1.4);
+}
+.slab .ltr.sp{width:.6em}
+/* Gõ trúng ký tự → chớp sáng 0.3s */
+.slab .ltr.hit{
+  opacity:1;
+  text-shadow:0 0 6px var(--slab-c),0 0 16px var(--slab-c),0 0 30px var(--slab-c);
+}
+/* Idle hint: cả cụm chữ "thở" nhẹ đúng một nhịp */
+.slab.breathe .ltr{animation:slabBreath 1.25s ease-in-out 1}
+@keyframes slabBreath{
+  0%,100%{opacity:.15;text-shadow:none}
+  50%{opacity:.72;text-shadow:0 0 8px var(--slab-c),0 0 18px var(--slab-c)}
+}
+/* Giải đúng → sáng rực 100% */
+.slab.solved{border-color:var(--slab-c);box-shadow:0 0 18px color-mix(in srgb,var(--slab-c) 45%,transparent),
+  inset 0 0 20px color-mix(in srgb,var(--slab-c) 18%,transparent)}
+.slab.solved .ltr{
+  opacity:1;animation:none;
+  text-shadow:0 0 6px var(--slab-c),0 0 14px var(--slab-c),0 0 34px var(--slab-c),0 0 60px var(--slab-c);
+}
+.slab .tick{position:absolute;width:4px;height:4px;background:var(--slab-c);opacity:.45}
+.slab .tick.a{left:-1px;top:-1px}.slab .tick.b{right:-1px;top:-1px}
+.slab .tick.c{left:-1px;bottom:-1px}.slab .tick.d{right:-1px;bottom:-1px}
+.slab.solved .tick{opacity:1;box-shadow:0 0 8px var(--slab-c)}
+
+/* ── Hotspot lá thư trên miệng rồng ─────────────────────────────────────── */
+.hotspot{
+  position:absolute;left:var(--hx);top:var(--hy);width:var(--hw);height:var(--hh);
+  transform:translate(-50%,-50%);
+  display:none;align-items:center;justify-content:center;
+  background:none;border:0;padding:0;z-index:4;cursor:pointer;
+}
+.hotspot.on{display:flex}
+.hotspot .glow{
+  position:absolute;inset:-6%;
+  background:radial-gradient(ellipse at center,rgba(255,225,140,.75) 0%,rgba(255,190,60,.35) 40%,transparent 72%);
+  mix-blend-mode:screen;animation:hotPulse 1.15s ease-in-out infinite;
+}
+.hotspot .ring{
+  position:absolute;inset:8% 4%;border:2px solid rgba(255,214,102,.9);
+  box-shadow:0 0 12px rgba(255,200,80,.9),inset 0 0 10px rgba(255,220,140,.6);
+  animation:hotRing 1.15s ease-in-out infinite;
+}
+@keyframes hotPulse{0%,100%{opacity:.55;transform:scale(.94)}50%{opacity:1;transform:scale(1.1)}}
+@keyframes hotRing{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:1;transform:scale(1.07)}}
+.hotspot .tap{
+  position:absolute;top:104%;left:50%;transform:translateX(-50%);
+  font-family:var(--f-pixel);font-size:6.5px;letter-spacing:.04em;white-space:nowrap;
+  color:#ffe08a;text-shadow:0 0 8px rgba(255,180,40,.9),0 2px 0 #000;
+  animation:tapBlink 1.15s steps(1) infinite;
+}
+@keyframes tapBlink{0%,49%{opacity:1}50%,100%{opacity:.25}}
+
+/* ── Lớp clip animation (rung khóa / nổ sập lab) ────────────────────────── */
+.anim-layer{position:absolute;inset:0;z-index:5;display:none;background:#05080d}
+.anim-layer.on{display:block}
+.anim-layer img{width:100%;height:100%;object-fit:cover;display:block}
+
+/* ── Hiệu ứng CRT: scanline + vignette + flicker ────────────────────────── */
+.scan{
+  position:absolute;inset:0;z-index:6;pointer-events:none;
+  background:repeating-linear-gradient(180deg,rgba(0,0,0,.28) 0 1px,transparent 1px 3px);
+  mix-blend-mode:multiply;opacity:.55;
+}
+.glare{
+  position:absolute;inset:0;z-index:7;pointer-events:none;
+  background:radial-gradient(120% 90% at 50% 8%,rgba(120,200,255,.10),transparent 55%),
+             radial-gradient(140% 120% at 50% 50%,transparent 55%,rgba(0,0,0,.62) 100%);
+  animation:flick 5.5s steps(2) infinite;
+}
+@keyframes flick{0%,97%{opacity:1}98%{opacity:.86}100%{opacity:1}}
+
+.hint{
+  flex:0 0 auto;text-align:center;font-family:var(--f-term);font-size:9px;
+  color:rgba(215,226,238,.34);letter-spacing:.04em;
+}
+
+/* ═══ NỬA DƯỚI · NARRATIVE & CONTROL TERMINAL ══════════════════════════════ */
+#term{
+  flex:1 1 auto;min-height:0;
+  display:flex;flex-direction:column;gap:10px;
+  padding:12px 12px calc(12px + env(safe-area-inset-bottom,0px));
+}
+.narr{
+  flex:1 1 auto;min-height:64px;overflow-y:auto;overscroll-behavior:contain;
+  border:3px solid var(--neon);background:rgba(2,18,9,.62);
+  padding:11px 12px;
+  box-shadow:0 0 22px rgba(0,255,102,.16),inset 0 0 26px rgba(0,255,102,.06);
+  font-size:12.5px;line-height:1.62;
+  -webkit-overflow-scrolling:touch;
+}
+.narr.shake{animation:shake .42s linear 1}
+@keyframes shake{
+  0%,100%{transform:translateX(0)}15%{transform:translateX(-6px)}30%{transform:translateX(6px)}
+  45%{transform:translateX(-4px)}60%{transform:translateX(4px)}80%{transform:translateX(-2px)}
+}
+.line{margin:0 0 6px;color:var(--neon);text-shadow:0 0 8px rgba(0,255,102,.35);word-break:break-word}
