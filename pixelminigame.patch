+#unlock:active{transform:translateY(3px);box-shadow:0 1px 0 #026b2b}
+#unlock:disabled{filter:grayscale(.7);opacity:.5;box-shadow:0 4px 0 #1c3326}
+
+/* ═══ MÀN CHỜ / LOADING ════════════════════════════════════════════════════ */
+#boot{
+  position:absolute;inset:0;z-index:40;background:var(--bg);
+  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;
+  padding:24px;text-align:center;transition:opacity .5s ease;
+}
+#boot.gone{opacity:0;pointer-events:none}
+#boot h1{font-family:var(--f-pixel);font-size:13px;line-height:1.8;margin:0;color:var(--amber);
+  text-shadow:0 0 14px rgba(255,170,0,.5)}
+#boot .sub{font-size:12px;color:var(--muted);max-width:300px;line-height:1.6;margin:0}
+.bar{width:190px;height:12px;border:3px solid var(--bezel);padding:2px;background:#06111d}
