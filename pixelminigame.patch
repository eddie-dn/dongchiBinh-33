+.caret{display:inline-block;width:.62em;height:1em;background:currentColor;
+  vertical-align:-2px;animation:blink .9s steps(1) infinite}
+@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:0}}
+
+.ctrl{flex:0 0 auto;display:flex;gap:8px;align-items:stretch}
+.ctrl[hidden]{display:none}
+#answer{
+  flex:1 1 auto;min-width:0;
