+/* ═══ 1. CHIỀU CAO THẬT & BÀN PHÍM ẢO ═════════════════════════════════════
+   iOS không co layout viewport khi bàn phím bật — chỉ visualViewport đổi. Ghi
+   chiều cao thật vào --vh để khung game không bị đẩy khỏi màn hình.          */
+const vv = window.visualViewport;
+function syncVH(){
+  const h = vv ? vv.height : window.innerHeight;
+  document.documentElement.style.setProperty('--vh', h + 'px');
+  const kb = vv ? (window.innerHeight - vv.height > 120) : false;
+  document.body.classList.toggle('kb-open', kb);
+  fitBezel(); fitSlabs(); sizeFx();
+  /* #stage đổi chiều cao có transition .28s → đo lúc này là đo giữa chừng.
+     Đo lại một nhịp sau khi hiệu ứng dừng hẳn. */
+  clearTimeout(syncVH._t);
+  syncVH._t = setTimeout(()=>{ fitBezel(); fitSlabs(); }, 320);
+}
+
+/* Khung 16:9 phải vừa CẢ bề ngang lẫn chiều cao còn trống của nửa trên. Đo
+   chiều cao trống từ các phần tử anh em (HUD, dòng gợi ý) nên không vòng lặp
+   với chính khung. */
+function fitBezel(){
+  const stageH = el.stage.clientHeight;
+  if(!stageH) return;
+  const cs   = getComputedStyle(el.stage);
+  const pad  = parseFloat(cs.paddingTop) || 0;
+  const gap  = parseFloat(cs.rowGap) || 0;
+  const hintH= el.hint.offsetHeight;
+  const avail= stageH - pad - el.hud.offsetHeight - hintH - gap * (hintH ? 2 : 1);
+  const w    = Math.min(el.slot.clientWidth, Math.max(60, avail) * 16 / 9);
+  el.bezel.style.width = w.toFixed(1) + 'px';
+}
+if(vv){ vv.addEventListener('resize', syncVH); vv.addEventListener('scroll', syncVH); }
+window.addEventListener('resize', syncVH, {passive:true});
+el.stage.addEventListener('transitionend', e=>{
+  if(e.propertyName === 'height'){ fitBezel(); fitSlabs(); }
+});
+window.addEventListener('orientationchange', ()=>setTimeout(syncVH,250));
+syncVH();
+
+/* ═══ 2. CAMERA — LIA VÀO ROUND + VUỐT TỰ DO + TỰ TRÔI VỀ GIỮA ════════════
+   Ảnh nền rộng 2.28:1 nhưng khung chỉ 16:9 → dư ngang ~28% chính là biên độ
+   pan. Kéo tay thì tắt transition (bám ngón), thả ra thì bật lại một đường
+   ease-out dài để camera "trôi" về giữa (inertia).                          */
+const CAM = { x:0, max:0, drag:false, sx:0, base:0, moved:false, enabled:true };
+
+function camMax(){
+  const w = el.world.offsetWidth, s = el.screen.clientWidth;
+  return Math.max(0,(w - s)/2);
+}
+function camApply(){ el.world.style.setProperty('--pan', CAM.x.toFixed(2)+'px'); }
+function camTo(x, ms, easing){
+  el.world.style.transition = ms ? ('transform '+ms+'ms '+(easing||'cubic-bezier(.16,1,.3,1)')) : 'none';
+  CAM.x = x; camApply();
+}
+function camIntro(){
+  CAM.max = camMax();
+  camTo(-CAM.max * 0.88, 0);
+  requestAnimationFrame(()=>requestAnimationFrame(()=>{
+    camTo(0, T.intro_pan, 'cubic-bezier(.22,.61,.36,1)');
+  }));
+}
+function clamp(v,a,b){ return v<a?a:(v>b?b:v); }
+
+el.screen.addEventListener('pointerdown', e=>{
+  if(!CAM.enabled) return;
+  /* Chạm vào lá thư thì KHÔNG bắt đầu kéo camera: setPointerCapture() bên dưới
+     kéo pointerup về #screen, làm sự kiện click nhảy lên #screen thay vì lên
+     nút hotspot — bấm lá thư sẽ không ăn. */
+  if(e.target.closest && e.target.closest('.hotspot')) return;
+  CAM.max = camMax();
+  if(CAM.max <= 1) return;
+  CAM.drag = true; CAM.moved = false;
+  CAM.sx = e.clientX; CAM.base = CAM.x;
+  el.screen.classList.add('dragging');
+  el.world.style.transition = 'none';
+  try{ el.screen.setPointerCapture(e.pointerId); }catch(_){}
+});
+el.screen.addEventListener('pointermove', e=>{
+  if(!CAM.drag) return;
+  const dx = e.clientX - CAM.sx;
+  if(Math.abs(dx) > 6) CAM.moved = true;
+  CAM.x = clamp(CAM.base + dx, -CAM.max, CAM.max);
+  camApply();
+});
+function endDrag(){
+  if(!CAM.drag) return;
+  CAM.drag = false;
+  el.screen.classList.remove('dragging');
+  camTo(0, T.recenter);           /* trôi mượt về trung tâm */
+  setTimeout(()=>{ CAM.moved = false; }, 60);
+}
+el.screen.addEventListener('pointerup', endDrag);
+el.screen.addEventListener('pointercancel', endDrag);
+el.screen.addEventListener('pointerleave', endDrag);
+
+/* ═══ 3. HỘP THOẠI — TYPEWRITER CÓ HÀNG ĐỢI ══════════════════════════════ */
+const Q = []; let typing = false, skip = false;
+
+function say(text, cls){
+  return new Promise(res=>{ Q.push({text,cls,res}); pump(); });
+}
+function sayAll(v, cls){
+  if(Array.isArray(v)) return v.reduce((p,t)=>p.then(()=>say(t,cls)), Promise.resolve());
+  return say(v, cls);
+}
+function pump(){
+  if(typing || !Q.length) return;
+  typing = true; skip = false;
+  const job = Q.shift();
+  const p = document.createElement('p');
+  p.className = 'line ' + (job.cls || '');
+  const span = document.createElement('span');
+  const caret = document.createElement('i');
+  caret.className = 'caret';
+  p.appendChild(span); p.appendChild(caret);
+  el.narr.appendChild(p);
+  trimLog();
+
+  let i = 0;
+  const txt = job.text;
+  const step = ()=>{
+    if(skip){ span.textContent = txt; finishLine(); return; }
+    span.textContent = txt.slice(0, ++i);
+    el.narr.scrollTop = el.narr.scrollHeight;
+    if(i >= txt.length) finishLine();
+    else setTimeout(step, T.type_speed);
+  };
+  function finishLine(){
+    caret.remove();
+    el.narr.scrollTop = el.narr.scrollHeight;
+    typing = false;
+    job.res();
+    setTimeout(pump, 90);
+  }
+  setTimeout(step, 60);
+}
+function trimLog(){
+  while(el.narr.children.length > 40) el.narr.removeChild(el.narr.firstChild);
+}
+/* Chạm vào hộp thoại → hiện hết dòng đang chạy (không phải ai cũng kiên nhẫn) */
+el.narr.addEventListener('click', ()=>{ if(typing) skip = true; });
+
+/* ═══ 4. BỆ ĐÁ — DỰNG CHỮ, CHỚP SÁNG, THỞ, ĐỔI VỊ TRÍ ════════════════════ */
+function buildSlab(rowEl, word){
+  rowEl.innerHTML = '';
+  [...word].forEach(ch=>{
+    const s = document.createElement('span');
+    s.className = 'ltr' + (ch === ' ' ? ' sp' : '');
+    s.textContent = ch === ' ' ? '' : ch;
+    s.dataset.ch = ch;
+    rowEl.appendChild(s);
+  });
+}
+/* Cỡ chữ tính theo bề ngang MÀN HÌNH (không phải ảnh nền) để mọi máy đọc được */
+function fitSlabs(){
+  const w = el.screen.clientWidth || 320;
+  [[el.slab1, el.row1, C.round1], [el.slab2, el.row2, C.round2]].forEach(([slab,row,cfg])=>{
+    if(!row.children.length) return;
+    const n = row.children.length;
+    const fs = Math.max(7, (w * cfg.slab.width_frac) / (n * 1.16));
+    slab.style.fontSize = fs.toFixed(1) + 'px';   /* .row kế thừa từ đây */
+  });
+}
+function placeSlabs(){
+  el.slab1.style.setProperty('--sx', C.round1.slab.x);
+  el.slab1.style.setProperty('--sy', C.round1.slab.y);
+  el.slab1.style.setProperty('--slab-c', C.round1.color);
+  el.slab2.style.setProperty('--sx', C.round2.slab.x);
+  el.slab2.style.setProperty('--sy', C.round2.slab.y);
+  el.slab2.style.setProperty('--slab-c', C.round2.color);
+  el.hotspot.style.setProperty('--hx', C.round2.hotspot.x);
+  el.hotspot.style.setProperty('--hy', C.round2.hotspot.y);
+  el.hotspot.style.setProperty('--hw', C.round2.hotspot.w);
+  el.hotspot.style.setProperty('--hh', C.round2.hotspot.h);
+}
+
+/* Chớp sáng đúng chữ cái vừa gõ trúng.
+   Ưu tiên ô CÙNG VỊ TRÍ với ký tự vừa nhập; không trùng thì lấy ô đầu tiên
+   mang ký tự đó và chưa sáng gần đây. Xóa phím thì không gọi hàm này. */
+function flashLetter(ch, pos){
+  if(!S.slabRow || !ch) return;
+  const w = S.slabWord;
+  const cells = S.slabRow.children;
+  const c = ch.toUpperCase();
+  if(c === ' ') return;
+  if(w.indexOf(c) < 0) return;                 /* gõ trượt → không sáng */
+
+  let target = -1;
+  if(w[pos] === c) target = pos;
+  if(target < 0){
+    for(let i=0;i<w.length;i++){ if(w[i]===c && !S.litRecently[i]){ target = i; break; } }
+  }
+  if(target < 0) target = w.indexOf(c);
+  const cell = cells[target];
+  if(!cell) return;
+
+  S.litRecently[target] = true;
+  cell.classList.add('hit');
+  clearTimeout(cell._t);
+  cell._t = setTimeout(()=>{
+    cell.classList.remove('hit');
+    S.litRecently[target] = false;
+  }, 300);
+}
+function breatheSlab(){
+  const s = S.slabEl;
+  if(!s || s.classList.contains('solved')) return;
+  s.classList.remove('breathe');
+  void s.offsetWidth;                           /* ép trình duyệt chạy lại */
+  s.classList.add('breathe');
+  setTimeout(()=>s.classList.remove('breathe'), 1350);
+}
+function armIdle(){
+  clearTimeout(S.idleTimer);
+  if(S.done || S.inputLocked) return;
+  S.idleTimer = setTimeout(breatheSlab, T.idle_hint);
+}
+
+/* Đổi vị trí chữ (REZAR → RAZER) bằng kỹ thuật FLIP: đo trước, sắp lại DOM,
+   đo sau, đặt transform ngược rồi thả về 0 → chữ cái trượt sang chỗ mới. */
+function morphSlab(rowEl, toWord){
+  const spans = [...rowEl.children];
+  const first = spans.map(s=>s.getBoundingClientRect().left);
+  const used  = new Array(spans.length).fill(false);
+  const order = [];
+  [...toWord].forEach(ch=>{
+    let i = spans.findIndex((s,k)=> !used[k] && s.dataset.ch === ch);
+    if(i < 0) i = spans.findIndex((s,k)=> !used[k]);
+    if(i < 0) i = 0;
+    used[i] = true; order.push(spans[i]);
+  });
+  order.forEach(s=> rowEl.appendChild(s));
+  const last = order.map(s=>s.getBoundingClientRect().left);
+  order.forEach((s,k)=>{
+    const dx = first[spans.indexOf(s)] - last[k];
+    s.style.transition = 'none';
+    s.style.transform  = 'translateX(' + dx.toFixed(2) + 'px)';
+  });
+  requestAnimationFrame(()=>requestAnimationFrame(()=>{
+    order.forEach(s=>{
+      s.style.transition = 'transform .75s cubic-bezier(.6,-.2,.3,1.4), opacity .3s ease, text-shadow .3s ease';
+      s.style.transform  = 'translateX(0)';
+    });
+  }));
+}
+
+/* ═══ 5. NẠP TÀI NGUYÊN ══════════════════════════════════════════════════ */
+const cache = {};
+function load(src){
+  if(cache[src]) return cache[src];
+  cache[src] = new Promise(res=>{
+    const im = new Image();
+    im.onload = ()=>res(true);
+    im.onerror= ()=>res(false);
+    im.src = src;
+  });
+  return cache[src];
+}
+/* Clip webp lặp vô hạn → mỗi lần phát tạo <img> MỚI (cùng URL nên lấy từ cache
+   trình duyệt, không tải lại) để animation chạy lại từ đầu, xong thì gỡ ra. */
+async function playClip(src, ms){
+  await load(src);
+  el.animLayer.innerHTML = '';
+  const im = new Image();
+  im.src = src;
+  el.animLayer.appendChild(im);
+  el.animLayer.classList.add('on');
+  await wait(ms);
+  el.animLayer.classList.remove('on');
+  el.animLayer.innerHTML = '';
+}
+
+/* ═══ 6. Ô NHẬP ══════════════════════════════════════════════════════════ */
+function setInput(on, placeholder){
+  S.inputLocked = !on;
+  el.input.disabled = !on;
+  el.unlock.disabled = !on;
+  if(placeholder) el.input.placeholder = placeholder;
+  if(on) armIdle(); else clearTimeout(S.idleTimer);
+}
+function showCtrl(on){ el.ctrl.hidden = !on; }
+
+el.input.addEventListener('input', ()=>{
+  const raw = el.input.value.toUpperCase();
+  if(raw !== el.input.value){
+    const p = el.input.selectionStart;
+    el.input.value = raw;
+    try{ el.input.setSelectionRange(p,p); }catch(_){}
+  }
+  const v = el.input.value;
+  if(v.length > S.lastLen){                       /* CHỈ khi thêm ký tự */
+    flashLetter(v[v.length-1], v.length-1);
+  }
+  S.lastLen = v.length;
+  armIdle();
+});
+el.input.addEventListener('keydown', e=>{ if(e.key === 'Enter'){ e.preventDefault(); submit(); }});
+el.unlock.addEventListener('click', submit);
+/* Bàn phím bật → kéo ô nhập vào giữa vùng nhìn thấy */
+el.input.addEventListener('focus', ()=>{
+  setTimeout(()=>{ try{ el.input.scrollIntoView({block:'center',behavior:'smooth'}); }catch(_){} }, 320);
+});
+
+function norm(s){ return (s||'').toUpperCase().replace(/\s+/g,'').trim(); }
+function isRight(v, cfg){
+  const n = norm(v);
+  return cfg.accept.some(a=> norm(a) === n);
+}
+
+function submit(){
+  if(S.busy || S.inputLocked) return;
+  const v = el.input.value.trim();
+  if(!v) return;
+  const cfg = S.round === 1 ? C.round1 : C.round2;
+  if(isRight(v, cfg)) (S.round === 1 ? win1() : win2());
+  else fail(cfg);
+}
+
+async function fail(cfg){
+  S.busy = true;
+  setInput(false);
+  S.wrongs[S.round]++;
+  el.input.value = ''; S.lastLen = 0;
+
+  if(S.round === 1){
+    playClip(A('anim_wrong'), T.anim_wrong);      /* chạy song song với log */
+    await say(C.dialogues.round1_wrong, 'err');
+    if(S.wrongs[1] >= T.idle_wrongs) await say(C.dialogues.round1_wrong_hint, 'warn');
+  }else{
+    el.narr.classList.remove('shake'); void el.narr.offsetWidth;
+    el.narr.classList.add('shake');
+    el.aura.classList.add('angry');
+    setTimeout(()=>el.aura.classList.remove('angry'), 1400);
+    await say(C.dialogues.round2_wrong, 'err');
+    if(S.wrongs[2] >= T.idle_wrongs) await say(C.dialogues.round2_wrong_hint, 'warn');
+  }
+  /* Sai đủ số lần → cả cụm chữ thở một nhịp làm gợi ý */
+  if(S.wrongs[S.round] >= T.idle_wrongs) breatheSlab();
+
+  await wait(T.lock_after_bad);
+  setInput(true);
+  S.busy = false;
+  await say(C.dialogues.unlocked_input, 'sys');
+}
+
+/* ═══ 7. VÒNG 1 ══════════════════════════════════════════════════════════ */
+async function startRound1(){
+  S.round = 1; S.busy = true;
+  S.slabWord = C.round1.scrambled; S.slabRow = el.row1; S.slabEl = el.slab1;
+  document.body.classList.remove('r2');
+  el.hudRound.textContent = 'ROUND 01/02';
+  el.hud.classList.remove('ok');
