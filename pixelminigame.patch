+  letter-spacing:.05em;text-shadow:0 0 12px rgba(0,242,255,.6);padding:2px 0 4px;
+}
+/* Phần 1 — slideshow ảnh kỷ niệm */
+.slidebox{position:relative;width:100%;aspect-ratio:4/3;background:#040a12;
+  border:2px solid rgba(0,242,255,.35);overflow:hidden;flex:0 0 auto}
